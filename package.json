{
  "name": "dsh-result-budget",
  "version": "0.1.1",
  "description": "DeepSeek Harness plugin: size every tool result to the active model's context window, so local and small models are not flooded by one oversized output.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "context-window",
    "local-llm",
    "small-model"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wildchiken/dsh-result-budget.git"
  },
  "homepage": "https://github.com/Wildchiken/dsh-result-budget#readme",
  "bugs": {
    "url": "https://github.com/Wildchiken/dsh-result-budget/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
